# Use the Google AI (MakerSuite) API, not Vertex AI
GOOGLE_GENAI_USE_VERTEXAI=FALSE

# API key for Google Gemini models
GOOGLE_API_KEY=[ADD_API_KEY]

# The model to be used by the main orchestrator agent
MODEL="gemini-1.5-pro-latest"

# For image generation specifically
GEMINI_IMAGE_MODEL="imagen-3.0-generate-002"

# Optional debug flag
DEBUG=True

GOOGLE_CLOUD_PROJECT=[ADD_GOOGLE_CLOUD_PROJECT_NAME]
GOOGLE_CLOUD_LOCATION=[ADD_GOOGLE_CLOUD_PROJECT_LOCATION]
GCS_BUCKET_NAME=[ADD_BUCKET_NAME]
